# Database (Neon PostgreSQL)
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Domain for did:web identifiers (use 'localhost' for local dev)
DOMAIN=localhost

# Encryption key for private keys (generate: openssl rand -hex 32)
ENCRYPTION_KEY=your_encryption_key_here

# JWT Secret for authentication tokens (generate: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Vercel Blob storage token for avatar uploads
# Get from Vercel Dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Resend API key for email service
# Get from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email address to receive newsletter signups
POLYVERSE_NOTIFICATION_EMAIL=your_email@example.com

# Redis (optional — used for fast L1 actor caching)
# If omitted, the app falls back to DB-only caching.
REDIS_URL=redis://127.0.0.1:6379/0

# Google Generative AI API Key (Gemini)
# Get from https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_api_key_here



